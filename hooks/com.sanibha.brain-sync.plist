<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sanibha.brain-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOOKS__/brain-sync.sh</string>
  </array>

  <!-- launchd gives a job almost no environment and never sources ~/.zshrc. Anything
       else this needs goes in vault/hooks/.env, which common.sh sources explicitly. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>BRAIN_DIR</key>
    <string>__BRAIN__</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOOKS__/sync.log</string>
  <key>StandardErrorPath</key>
  <string>__HOOKS__/sync.log</string>
</dict>
</plist>
